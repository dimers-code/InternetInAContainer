# Copy to .env and edit.

# Which optional apps to run (comma-separated): kolibri, books, maps, files
#   files = the read-only file share at /files/. Remove it if you already share
#           files another way (Samba, Nextcloud, a NAS, ...).
COMPOSE_PROFILES=kolibri,books,files

# Port the portal listens on. Use 8080 etc. if 80 is taken on your machine.
HTTP_PORT=80

# Where content lives. On Windows/macOS, large ZIM libraries are much faster on
# a Linux filesystem (e.g. inside WSL: /home/you/iiab-data) than on a bind-mounted
# Windows drive.
DATA_DIR=./data

# Calibre-Web
PUID=1000
PGID=1000
TZ=America/Chicago
# Uncomment to enable ebook conversion / uploads (x86-64 hosts only):
# CALIBRE_MODS=linuxserver/mods:universal-calibre

# Pin versions here if you want reproducible deploys
KIWIX_VERSION=latest
KOLIBRI_VERSION=0.19.5
# Kolibri image from a registry. Point this at your own fork's package if you
# publish one; Compose builds ./kolibri locally if the pull fails.
# KOLIBRI_IMAGE=ghcr.io/duimstpj/iiab-kolibri
TILESERVER_VERSION=latest
